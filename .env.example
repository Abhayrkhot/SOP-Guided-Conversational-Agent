# Default rules mode is limited. Enable model mode for semantic conversations.
LLM_MODE=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_JSON_SCHEMA=true
LLM_TIMEOUT_SECONDS=20
